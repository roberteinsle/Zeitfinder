APP_NAME="Zeitfinder"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=de
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# PostgreSQL aus docker-compose.yml (docker compose up -d db)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=app

CACHE_STORE=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Lokal landen Mails im Log
MAIL_MAILER=log

# First admin (never hard-coded). Signs in via magic link, must then register a passkey.
ADMIN_EMAIL=

# true only if the server accepts web traffic exclusively via Cloudflare (real visitor IP from CF-Connecting-IP)
BEHIND_CLOUDFLARE=false

# Footer credit "Made with ♥ in <place> by <name>"; hidden without a name. URL must be https.
CREDIT_NAME=
CREDIT_URL=
CREDIT_PLACE=

MAIL_FROM_ADDRESS=zeitfinder@example.com
MAIL_FROM_NAME="${APP_NAME}"
